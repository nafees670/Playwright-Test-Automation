{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["@playwright/test", "node"]
  },
  "include": ["tests/**/*.ts", "utils/**/*.ts", "playwright.config.ts"]
}
